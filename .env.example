# Projetos exibidos na cena "Projetos" (lidos só no servidor; nunca use o prefixo NEXT_PUBLIC_).
# Crie o token em https://vercel.com/account/tokens com leitura de projetos e deployments.
VERCEL_API_TOKEN=
# Opcional: apenas para contas de time.
VERCEL_TEAM_ID=

# Opcional: URL canônica usada em metadados e Open Graph.
NEXT_PUBLIC_SITE_URL=https://my-landing-olive.vercel.app
